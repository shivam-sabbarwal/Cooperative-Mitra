# Copy this file to .env for local development. Never commit a populated .env.
ENVIRONMENT=development
APP_NAME=Cooperative Mitra
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Generate a unique random value for every deployment.
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local runtime services
DATABASE_URL=sqlite:///./cooperative_mitra.db
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# RAG and voice
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PERSIST_DIRECTORY=nlp-rag/knowledge_base/chroma_db
CHROMA_COLLECTION_NAME=cooperative_knowledge
WHISPER_MODEL=base
ENABLE_EDGE_TTS=true

# This value is intentionally public: it is the browser's backend base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
